# Git 忽略规则：本地配置、依赖、构建缓存与运行数据不纳入版本管理。
# 保留 .env.example 作为可共享的环境变量模板。

# Local environment
.env
.env.*
!.env.example
.mcp.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/.next-dev/
frontend/out/
frontend/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
tmp/
.codex_tmp/
.data/
.devflow/
*.db
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.log
backend/.data/
backend/devflow_demo.db
devflow_demo.db

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
